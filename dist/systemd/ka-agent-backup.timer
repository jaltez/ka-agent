# Nightly at 03:30 (catches up after sleep/reboot).
# Install:
#   cp dist/systemd/ka-agent-backup.{service,timer} ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now ka-agent-backup.timer

[Unit]
Description=Ka Agent nightly backup timer

[Timer]
OnCalendar=*-*-* 03:30:00
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target

# Nightly backup (oneshot): state + memory + notes + config →
# %h/.local/share/ka-agent/backups/nightly.
# Install alongside ka-agent-backup.timer.

[Unit]
Description=Ka Agent nightly backup

[Service]
Type=oneshot
ExecStart=%h/.local/bin/ka-agent backup %h/.local/share/ka-agent/backups/nightly
Environment=KA_AGENT_DATA_DIR=%h/.local/share/ka-agent
# A live daemon is fine: the backup uses SQLite's consistent snapshot.
